@using Payments.Mvc.Models.Roles
@using Payments.Core.Domain
@model Payments.Mvc.Models.TeamViewModels.EditTeamViewModel

@{
    ViewData["Title"] = "Edit Team";
}

@section AdditionalStyles {
    <style asp-add-nonce="true">
        #naturalAccountResults {
            max-height: 16rem;
            overflow-y: auto;
        }
    </style>
}

<div class="card overflow-visible">
    <div class="card-header card-header-primary d-flex justify-content-between align-items-start">
        <h1>@ViewBag.Title</h1>
        <a asp-action="Index">Back</a>
    </div>
    <div class="card-body">
        <div class="row">
            <div class="col-md-4">
                <form asp-action="Edit" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <div class="form-group">
                        <label asp-for="Name" class="control-label"></label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="Slug" class="control-label"></label>
                        <input asp-for="Slug" class="form-control" />
                        <span asp-validation-for="Slug" class="text-danger"></span>
                        <span id="slugUrl"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="ContactName" class="control-label"></label>
                        <input asp-for="ContactName" class="form-control" />
                        <span asp-validation-for="ContactName" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="ContactEmail" class="control-label"></label>
                        <input asp-for="ContactEmail" class="form-control" />
                        <span asp-validation-for="ContactEmail" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="ContactPhoneNumber" class="control-label"></label>
                        <input asp-for="ContactPhoneNumber" class="form-control" />
                        <span asp-validation-for="ContactPhoneNumber" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="WebHookApiKey" class="control-label"></label>
                        <input asp-for="WebHookApiKey" class="form-control" />
                        <span asp-validation-for="WebHookApiKey" class="text-danger"></span>
                        <div class="text-muted">Leave blank if you don't want to pass authorization to your webhook URL
                        </div>
                    </div>

                    @{
                        bool isAdmin = User.IsInRole(ApplicationRoleCodes.Admin);
                        string labelClass = isAdmin ? "form-check-label ms-2" : "form-check-label ms-2 text-muted";
                    }

                    <div class="form-group">
                        <label asp-for="AllowedInvoiceType" class="control-label"></label>
                        <div class="ms-3">
                            <div class="form-check d-flex">
                                <input asp-for="AllowedInvoiceType" class="form-check-input" type="radio"
                                       value="@Team.AllowedInvoiceTypes.CreditCard" disabled="@(!isAdmin)" />
                                <label class="@labelClass" asp-for="AllowedInvoiceType">Credit Card Only</label>
                            </div>
                            <div class="form-check d-flex">
                                <input asp-for="AllowedInvoiceType" class="form-check-input" type="radio"
                                       value="@Team.AllowedInvoiceTypes.Recharge" disabled="@(!isAdmin)" />
                                <label class="@labelClass" asp-for="AllowedInvoiceType">Recharge Only</label>
                            </div>
                            <div class="form-check d-flex">
                                <input asp-for="AllowedInvoiceType" class="form-check-input" type="radio"
                                       value="@Team.AllowedInvoiceTypes.Both" disabled="@(!isAdmin)" />
                                <label class="@labelClass" asp-for="AllowedInvoiceType">Both</label>
                            </div>
                        </div>
                        @if (!isAdmin)
                        {
                            <input asp-for="AllowedInvoiceType" type="hidden" />
                            <div class="text-muted small mt-1">If you need to change the allowed invoice type, please submit
                                a help ticket.</div>
                            }
                            <span asp-validation-for="AllowedInvoiceType" class="text-danger"></span>
                        </div>

                        @if (isAdmin)
                        {
                            <div class="form-group">
                                <div class="form-check">
                                    <input asp-for="UseCustomAccountValidation" class="form-check-input" />
                                    <label asp-for="UseCustomAccountValidation" class="form-check-label ms-2"></label>
                                </div>
                                <span asp-validation-for="UseCustomAccountValidation" class="text-danger"></span>
                            </div>
                            @if (Model.ShowRechargeDebitNaturalAccount)
                            {
                                <div class="form-group">
                                    <label asp-for="RechargeDebitNaturalAccount" class="control-label"></label>
                                    <div id="naturalAccountLookup" class="position-relative">
                                        <input asp-for="RechargeDebitNaturalAccount" class="form-control" autocomplete="off"
                                               maxlength="100" placeholder="Search by name or exact account code"
                                               disabled="@(!Model.UseCustomAccountValidation)" aria-describedby="naturalAccountHelp naturalAccountStatus"
                                               role="combobox" aria-autocomplete="list" aria-controls="naturalAccountResults" aria-expanded="false" />
                                        <div id="naturalAccountResults" class="dropdown-menu top-100 start-0 w-100 shadow"
                                             role="listbox" aria-label="Natural account search results"></div>
                                    </div>
                                    <span asp-validation-for="RechargeDebitNaturalAccount" class="text-danger"></span>
                                    <div id="naturalAccountStatus" class="text-muted small" role="status" aria-live="polite"></div>
                                    <div id="naturalAccountHelp" class="text-muted small">
                                        Optional. Search and select an account, or leave blank to remove the override.
                                        Turning off custom account validation clears this override.
                                    </div>
                                </div>
                            }

                            <div class="form-group">
                                <div class="form-check">
                                    <input asp-for="SlothAutoApprove" class="form-check-input" disabled="@(!isAdmin)" />
                                    <label asp-for="SlothAutoApprove" class="@labelClass"></label>
                                </div>
                                <span asp-validation-for="SlothAutoApprove" class="text-danger"></span>
                            </div>

                            <div class="form-group">
                                <div class="checkbox">
                                    <label>
                                        <input asp-for="IsActive" /> @Html.DisplayNameFor(model => model.IsActive)
                                    </label>
                                </div>
                            </div>
                        }

                        <div class="form-group">
                            <input type="submit" value="Save" class="btn btn-primary" />
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <div>
        <a class="btn btn-outline-primary" asp-action="Index"><i class="fas fa-chevron-left"></i>Back to Team</a>
    </div>

    @section Scripts {
        <partial name="_ValidationScriptsPartial" />

        <script asp-add-nonce="true">
                $(function () {
                    var dirtySlug = false;
                    $('#Name').keyup(function () {
                        if (dirtySlug) {
                            return;
                        }
                        var slug = $(this).val();
                        slug = slug.replace(/[\W_]/g, '-');
                        slug = slug.replace(/--*/g, '-');
                        slug = slug.trim('-');
                        slug = slug.toLowerCase();

                        $('#Slug').val(slug);
                        updateSlugUrl();
                    });

                    $('#Slug').change(function () {
                        dirtySlug = true;
                        updateSlugUrl();
                    });

                    function updateSlugUrl() {
                        var slug = $('#Slug').val();
                        $('#slugUrl').text("https://payments.ucdavis.edu/" + slug);
                    }

                    var customValidation = $('#UseCustomAccountValidation');
                    var naturalAccount = $('#RechargeDebitNaturalAccount');
                    if (!customValidation.length || !naturalAccount.length) {
                        return;
                    }

                    var lookup = $('#naturalAccountLookup');
                    var results = $('#naturalAccountResults');
                    var status = $('#naturalAccountStatus');
                    var searchUrl = '@Url.Action("SearchNaturalAccounts", "Settings", new { team = Model.Slug })';
                    var searchTimer;
                    var searchRequest;
                    var searchVersion = 0;
                    var activeResult = -1;
                    var dropdownDismissed = false;

                    function hideResults() {
                        results.removeClass('show');
                        results.children().removeClass('active').attr('aria-selected', 'false');
                        naturalAccount.attr('aria-expanded', 'false').removeAttr('aria-activedescendant');
                        activeResult = -1;
                        dropdownDismissed = true;
                    }

                    function showResults() {
                        if (results.children().length) {
                            results.addClass('show');
                            naturalAccount.attr('aria-expanded', 'true');
                        }
                    }

                    function resetSearch() {
                        clearTimeout(searchTimer);
                        searchVersion++;
                        if (searchRequest) {
                            searchRequest.abort();
                            searchRequest = null;
                        }
                        hideResults();
                        results.empty();
                        dropdownDismissed = false;
                    }

                    function updateNaturalAccountControls() {
                        resetSearch();
                        var enabled = customValidation.prop('checked');
                        naturalAccount.prop('disabled', !enabled);
                        if (!enabled) {
                            naturalAccount.val('');
                        }
                        status.text(enabled ? 'Enter at least 3 characters to search Aggie Enterprise.' : 'Enable custom account validation to select an account.');

                        var code = naturalAccount.val().trim();
                        if (enabled && /^[0-9A-Z]{6}$/.test(code)) {
                            var version = searchVersion;
                            status.text('Loading natural account name...');
                            searchRequest = $.getJSON(searchUrl, { query: code })
                                .done(function (accounts) {
                                    if (version !== searchVersion) {
                                        return;
                                    }
                                    var account = accounts.find(function (item) { return item.code === code; });
                                    status.text(account ? 'Selected: ' + account.code + ' — ' + account.name
                                        : 'This natural account could not be found or is no longer eligible.');
                                })
                                .fail(function (_, textStatus) {
                                    if (textStatus !== 'abort' && version === searchVersion) {
                                        status.text('Unable to load the natural account name. Search again to retry.');
                                    }
                                });
                        }
                    }

                    customValidation.on('change', updateNaturalAccountControls);
                    naturalAccount.on('focus', function () {
                        dropdownDismissed = false;
                        showResults();
                    });
                    lookup.on('focusout', function (event) {
                        if (!lookup[0].contains(event.relatedTarget)) {
                            hideResults();
                        }
                    });
                    $(document).on('pointerdown', function (event) {
                        if (!lookup[0].contains(event.target)) {
                            hideResults();
                        }
                    });
                    results.on('mousedown', 'button', function (event) {
                        event.preventDefault();
                    });
                    naturalAccount.on('keydown', function (event) {
                        if (event.key === 'Escape') {
                            event.preventDefault();
                            hideResults();
                        }
                        else if ((event.key === 'ArrowDown' || event.key === 'ArrowUp') && results.children().length) {
                            event.preventDefault();
                            dropdownDismissed = false;
                            showResults();
                            var options = results.children();
                            activeResult = event.key === 'ArrowDown'
                                ? (activeResult + 1) % options.length
                                : (activeResult <= 0 ? options.length - 1 : activeResult - 1);
                            options.removeClass('active').attr('aria-selected', 'false');
                            var option = options.eq(activeResult).addClass('active').attr('aria-selected', 'true');
                            naturalAccount.attr('aria-activedescendant', option.attr('id'));
                            option[0].scrollIntoView({ block: 'nearest' });
                        }
                        else if (event.key === 'Enter' && results.hasClass('show') && activeResult >= 0) {
                            event.preventDefault();
                            results.children().eq(activeResult).trigger('click');
                        }
                    });
                    naturalAccount.on('input', function () {
                        resetSearch();
                        var query = naturalAccount.val().trim();
                        if (!query) {
                            naturalAccount.val('').valid();
                            status.text('No override selected. Enter at least 3 characters to search.');
                            return;
                        }
                        if (query.length < 3) {
                            status.text('Enter at least 3 characters to search Aggie Enterprise.');
                            return;
                        }

                        var version = searchVersion;
                        status.text('Searching Aggie Enterprise...');
                        searchTimer = setTimeout(function () {
                            searchRequest = $.getJSON(searchUrl, { query: query })
                                .done(function (accounts) {
                                    if (version !== searchVersion) {
                                        return;
                                    }
                                    status.text(accounts.length ? 'Select a natural account from the dropdown.' : 'No eligible natural accounts found.');
                                    accounts.forEach(function (account, index) {
                                        $('<button>', {
                                            type: 'button', class: 'dropdown-item text-wrap py-2',
                                            id: 'naturalAccountOption' + index, role: 'option', tabindex: -1, 'aria-selected': 'false'
                                        })
                                            .text(account.code + ' — ' + account.name)
                                            .on('click', function () {
                                                resetSearch();
                                                naturalAccount.val(account.code).trigger('focus');
                                                status.text('Selected: ' + account.code + ' — ' + account.name);
                                                naturalAccount.valid();
                                            })
                                            .appendTo(results);
                                    });
                                    if (naturalAccount.is(':focus') && !dropdownDismissed) {
                                        showResults();
                                    }
                                })
                                .fail(function (_, textStatus) {
                                    if (textStatus !== 'abort' && version === searchVersion) {
                                        status.text('Unable to search Aggie Enterprise. Please try again.');
                                    }
                                });
                        }, 300);
                    });
                    updateNaturalAccountControls();
                });
        </script>
    }
